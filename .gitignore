.Rhistory
.RData
.Ruserdata
.DS_Store
.log
uv.lock
.venv

# Quarto
.quarto/
docs/_site/

# Temporary files
.temp/

# Python bytecode (scripts/ import each other, so this appears on any run)
__pycache__/

*.css
*.html
*.pdf
*.js
*.woff

# But keep Stanford theme assets
!docs/styles.css
!docs/fonts/*.woff

# ...and hand-written site scripts (docs/assets/ holds only source, never build
# output, so it is safe to un-ignore wholesale)
!docs/assets/*.js
