FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.6.5 /uv /usr/local/bin/uv

ARG QUARTO_VERSION=1.7.29
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends ca-certificates curl git \
 && arch="$(dpkg --print-architecture)" \
 && curl -fsSL -o /tmp/quarto.deb \
      "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${arch}.deb" \
 && apt-get install -y --no-install-recommends /tmp/quarto.deb \
 && rm /tmp/quarto.deb \
 && apt-get clean

ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /opt/dependencies
COPY pyproject.toml ./
RUN uv sync --no-dev --no-install-project \
 && uv pip install --python /opt/venv/bin/python "ruff==0.13.0"

WORKDIR /workspace
CMD ["python", "scripts/build_site.py", "--offline"]
